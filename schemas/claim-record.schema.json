{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamnet.ink/schemas/claim-record.v1.json",
  "title": "DreamNet Claim Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "claimDigest",
    "statement",
    "scope",
    "risk",
    "evidence",
    "producerReceiptDigest",
    "status",
    "producerFactoryId",
    "producedBy",
    "createdAt"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "pattern": "^claim_[a-f0-9]{32}$"
    },
    "claimDigest": {
      "$ref": "#/$defs/digest"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "jurisdiction": { "type": "string" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" }
      }
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "contradicts": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "producerReceiptDigest": {
      "$ref": "#/$defs/digest"
    },
    "status": {
      "enum": [
        "proposed",
        "supported",
        "verified",
        "disputed",
        "rejected",
        "superseded",
        "expired",
        "retracted"
      ]
    },
    "producerFactoryId": {
      "type": "string",
      "minLength": 1
    },
    "producedBy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agentId", "role"],
        "properties": {
          "agentId": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "relationship",
        "artifactDigest",
        "sourceUri",
        "sourceSpan",
        "observedAt",
        "provenanceReceiptDigest",
        "visibility"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 1 },
        "relationship": { "enum": ["supports", "challenges"] },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "sourceUri": { "type": "string", "minLength": 1 },
        "sourceSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end", "quoteDigest"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 },
            "quoteDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "provenanceReceiptDigest": { "$ref": "#/$defs/digest" },
        "visibility": { "enum": ["public", "restricted", "private"] }
      }
    }
  }
}

